{
  "name": "generx-qa-automation",
  "version": "1.0.0",
  "description": "Comprehensive E2E, Load, Security, and Web Testing Framework for GeneRx",
  "main": "index.js",
  "scripts": {
    "test:appium": "mocha tests/appium/**/*.test.js --reporter mochawesome",
    "test:selenium": "mocha tests/selenium/**/*.test.js --reporter mochawesome",
    "test:load": "k6 run tests/load/k6-load-test.js",
    "report:excel": "node utils/excelGenerator.js",
    "ai:smart-test": "node utils/aiSmartTester.js"
  },
  "dependencies": {
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^2.29.0",
    "axios": "^1.6.0",
    "chai": "^4.3.10",
    "exceljs": "^4.3.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.15.0",
    "webdriverio": "^8.20.0",
    "winston": "^3.11.0"
  }
}
